# Provenance-hashed bytes must be identical on every platform: model manifests
# record MD5s of .gltf JSON, and gen-map-runtime embeds sha256 of the map
# source spec and shots. CRLF checkout conversion breaks those hashes on Windows.
*.gltf -text
apps/client/assets-src/maps/** text eol=lf
apps/client/public/maps/** text eol=lf

*.pdf binary
