# Environment variable names used by the API functions (api/, server/) and the
# ops scripts (scripts/ops/). Names only: never commit values. Set production
# values in the Vercel project settings; for local ops runs copy this file to an
# ignored .env.*.local file and pass it with --env-file.
#
# `pnpm dev` does not need any of these: the Vite dev server serves the API from
# an in-memory store with development fallbacks.

# --- Postgres (Neon) --------------------------------------------------------
# Production needs at least one write-chain variable; without one the API has
# no shared-champion store. The first non-empty variable in a chain wins.
# Write chain:     POSTGRES_WRITE_URL -> POSTGRES_URL -> POSTGRES_URL_NON_POOLING
#                  -> DATABASE_URL -> NEON_DATABASE_URL
# Read chain:      POSTGRES_READ_URL, then the write chain (also used by db:export).
# Reconcile chain: POSTGRES_URL_NON_POOLING -> DATABASE_URL_UNPOOLED
#                  -> POSTGRES_WRITE_URL -> POSTGRES_URL -> DATABASE_URL
#                  -> NEON_DATABASE_URL (db:reconcile, db:validate-constraints;
#                  use a direct, non-pooled URL).
POSTGRES_WRITE_URL=
POSTGRES_READ_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_DATABASE_URL=

# --- App secrets and flags ---------------------------------------------------
# Required in production: HMAC key for stored IP and user-agent fingerprints,
# at least 32 characters. The API fails closed when it is missing or short.
PRIVACY_HASH_SECRET=
# Bearer token for /api/admin/stats/* (and pnpm ops:stats). Without it the
# admin stats endpoints return 503 in production.
STATS_ADMIN_TOKEN=
# Optional. true/false override for accepting public run submissions
# (default: enabled).
SHARED_CHAMPION_ENABLE_PUBLIC_RUNS=

# --- Set by Vercel (do not set by hand) ----------------------------------------
# VERCEL (or NODE_ENV=production) switches the API to production mode.
# VERCEL_GIT_COMMIT_SHA -> VERCEL_GIT_COMMIT_REF -> VERCEL_URL -> VERCEL_BRANCH_URL
# label recorded runs with the deployment build. VERCEL_ENV is only set by the
# local QA server.
