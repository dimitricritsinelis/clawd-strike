{
  "name": "clawd-strike",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@vercel/functions": "^3.2.10",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "vite": "^6.0.11"
  },
  "scripts": {
    "dev": "pnpm --filter @clawd-strike/client dev -- --port 5174",
    "build": "pnpm --filter @clawd-strike/client build",
    "preview": "pnpm --filter @clawd-strike/client preview",
    "export:agent-sdk": "tsx scripts/export-agent-sdk.ts",
    "export:postgres-audit": "tsx scripts/export-postgres-audit.ts",
    "reconcile:shared-champion": "tsx scripts/reconcile-shared-champion.ts",
    "validate:shared-champion-constraints": "tsx scripts/validate-shared-champion-constraints.ts",
    "stats:admin": "bash apps/client/scripts/admin-stats.sh",
    "test:agent-sdk-export": "tsx --test scripts/export-agent-sdk.test.ts",
    "test:postgres-audit": "tsx --test scripts/export-postgres-audit.test.ts",
    "map:check": "node --import tsx scripts/map-guard.ts check",
    "test:map-tooling": "node --import tsx --test scripts/lib/mapGuard.test.ts && pnpm --filter @clawd-strike/client test:map-tooling",
    "test:qa-tooling": "pnpm --filter @clawd-strike/client test:qa-tooling",
    "test:map-runtime": "pnpm --filter @clawd-strike/client test:map-runtime",
    "typecheck": "pnpm --filter @clawd-strike/client exec tsc -p ../../tsconfig.json --noEmit && pnpm --filter @clawd-strike/client typecheck",
    "test:server": "tsx --test ./server/highScoreStoreImpl.test.ts ./server/highScoreHardening.test.ts",
    "smoke:game": "pnpm --filter @clawd-strike/client smoke:game",
    "bot:smoke:owned": "pnpm --filter @clawd-strike/client bot:smoke:owned",
    "test:playwright:full": "pnpm --filter @clawd-strike/client test:playwright:full",
    "smoke:no-context": "pnpm --filter @clawd-strike/client smoke:no-context",
    "verify:skills-contract": "pnpm --filter @clawd-strike/client verify:skills-contract",
    "capture:shots": "pnpm --filter @clawd-strike/client capture:shots",
    "qa:completion": "pnpm --filter @clawd-strike/client qa:completion",
    "qa:release": "pnpm --filter @clawd-strike/client test:map-traversal:blockout && pnpm qa:completion && pnpm bot:smoke:owned && pnpm build"
  }
}
