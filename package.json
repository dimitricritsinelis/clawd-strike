{
  "name": "clawd-strike",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@vercel/functions": "^3.2.10",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "knip": "^6.38.0",
    "tsx": "^4.20.6",
    "vite": "^6.0.11",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "dev": "pnpm --filter @clawd-strike/client dev",
    "build": "pnpm --filter @clawd-strike/client build",
    "preview": "pnpm --filter @clawd-strike/client preview",
    "typecheck": "pnpm --filter @clawd-strike/client exec tsc -p ../../tsconfig.json --noEmit && pnpm --filter @clawd-strike/client typecheck",
    "lint:unused": "knip",
    "check:maps": "pnpm --filter @clawd-strike/client gen:maps:check",
    "test": "pnpm test:unit && pnpm test:tools && pnpm test:server",
    "test:unit": "node apps/client/scripts/run-unit-tests.mjs",
    "test:tools": "node --test 'apps/client/scripts/**/*.test.mjs' 'scripts/**/*.test.mjs' && tsx --test 'scripts/**/*.test.ts'",
    "test:server": "tsx --test 'server/*.test.ts'",
    "test:postgres": "REQUIRE_TEST_POSTGRES=1 tsx --test server/realPostgres.integration.test.ts",
    "test:e2e:smoke": "pnpm --filter @clawd-strike/client test:e2e:smoke",
    "test:e2e": "pnpm --filter @clawd-strike/client test:e2e",
    "test:e2e:headed": "pnpm --filter @clawd-strike/client test:e2e:headed",
    "test:e2e:pointer-lock": "pnpm --filter @clawd-strike/client test:e2e:pointer-lock",
    "test:e2e:traversal": "pnpm --filter @clawd-strike/client test:e2e:traversal",
    "test:e2e:traversal:blockout": "pnpm --filter @clawd-strike/client test:e2e:traversal:blockout",
    "test:e2e:traversal:focused": "pnpm --filter @clawd-strike/client test:e2e:traversal:focused",
    "smoke:bots": "pnpm --filter @clawd-strike/client smoke:bots",
    "smoke:public": "pnpm --filter @clawd-strike/client smoke:public",
    "verify:skills": "pnpm --filter @clawd-strike/client verify:skills",
    "capture:shots": "pnpm --filter @clawd-strike/client capture:shots",
    "qa:completion": "pnpm --filter @clawd-strike/client qa:completion",
    "qa:release": "pnpm check:maps && pnpm test && pnpm test:e2e:traversal && pnpm qa:completion && pnpm smoke:bots && pnpm build",
    "map:check": "node --import tsx scripts/map-guard.ts check",
    "assets:loading-screen": "pnpm --filter @clawd-strike/client assets:loading-screen",
    "assets:loading-screen:verify": "pnpm --filter @clawd-strike/client assets:loading-screen:verify",
    "assets:facade": "node scripts/assets/apply-facade-package.mjs",
    "assets:fetch-texture": "node scripts/assets/fetch-cc0-texture.mjs",
    "assets:fetch-model": "node scripts/assets/fetch-cc0-model.mjs",
    "sdk:export": "tsx scripts/sdk/export-agent-sdk.ts",
    "db:export": "tsx scripts/ops/export-postgres-audit.ts",
    "db:reconcile": "tsx scripts/ops/reconcile-shared-champion.ts",
    "db:validate-constraints": "tsx scripts/ops/validate-shared-champion-constraints.ts",
    "ops:stats": "bash scripts/ops/admin-stats.sh"
  },
  "engines": {
    "node": "22.x"
  }
}
