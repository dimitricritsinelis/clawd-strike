{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawdstrike.local/schemas/composition-waivers-v1.json",
  "title": "Clawd Strike composition waiver registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "waivers"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "match": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchorId", "openingIds"],
          "properties": {
            "anchorId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "openingIds": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["placementIds"],
          "properties": {
            "placementIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["placementId", "openingId"],
          "properties": {
            "placementId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "openingId": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "approval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "legacyRef"],
          "properties": {
            "status": {
              "const": "legacy-migrated"
            },
            "legacyRef": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approver", "ticket"],
          "properties": {
            "status": {
              "const": "approved"
            },
            "approver": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "ticket": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "signature",
        "match",
        "reasonCode",
        "rationale",
        "approval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CW-[A-F0-9]{12}$"
        },
        "kind": {
          "enum": [
            "canopy-opening",
            "decoration-opening",
            "fixture-axis",
            "fixture-buffer",
            "hard-overlap",
            "opening-service"
          ]
        },
        "signature": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "reasonCode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "expiresOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
