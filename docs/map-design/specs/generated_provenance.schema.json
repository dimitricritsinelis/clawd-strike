{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawdstrike.local/schemas/generated-provenance-v1.json",
  "title": "Clawd Strike generated-map provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "path", "sha256", "generator"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generator": {
      "const": "apps/client/scripts/gen-map-runtime.mjs"
    }
  }
}
