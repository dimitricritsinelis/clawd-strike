{
  "name": "@clawd-strike/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm gen:maps",
    "prebuild": "pnpm gen:maps",
    "prepreview": "pnpm gen:maps",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:maps": "node scripts/gen-map-runtime.mjs",
    "gen:maps:check": "node scripts/gen-map-runtime.mjs --check",
    "test:e2e:smoke": "node scripts/run-playwright-qa.mjs test playwright/runtime-boot.spec.ts playwright/agent-traversal.spec.ts playwright/death-restart.spec.ts playwright/desktop-human-profile.spec.ts",
    "test:e2e": "node scripts/run-playwright-qa.mjs test",
    "test:e2e:headed": "node scripts/run-playwright-qa.mjs test --headed",
    "test:e2e:pointer-lock": "PW_POINTER_LOCK=1 node scripts/run-playwright-qa.mjs test playwright/manual-pointer-lock.spec.ts --headed --workers=1",
    "test:e2e:traversal": "BAZAAR_TRAVERSAL_SCOPE=canonical BAZAAR_TRAVERSAL_PROFILE=final node scripts/run-playwright-qa.mjs test playwright/bazaar-v3-traversal.spec.ts --workers=1",
    "test:e2e:traversal:blockout": "BAZAAR_TRAVERSAL_SCOPE=canonical BAZAAR_TRAVERSAL_PROFILE=blockout node scripts/run-playwright-qa.mjs test playwright/bazaar-v3-traversal.spec.ts --workers=1",
    "test:e2e:traversal:focused": "BAZAAR_TRAVERSAL_SCOPE=focused node scripts/run-playwright-qa.mjs test playwright/bazaar-v3-traversal.spec.ts --workers=1",
    "smoke:bots": "node scripts/run-owned-bot-smoke.mjs",
    "smoke:public": "node scripts/no-context-agent-smoke.mjs",
    "smoke:headshot-kill-perf": "node scripts/headshot-kill-perf-smoke.mjs",
    "smoke:orb-scaling-perf": "node scripts/orb-scaling-perf-smoke.mjs",
    "smoke:loading-screen-perf": "node scripts/loading-screen-perf-smoke.mjs",
    "smoke:wave-ammo-reset": "node scripts/wave-ammo-reset-smoke.mjs",
    "verify:skills": "node scripts/verify-skills-contract.mjs",
    "capture:shots": "node scripts/capture-map-shots.mjs",
    "qa:completion": "node scripts/qa-completion-gate.mjs",
    "assets:loading-screen": "node scripts/optimize-loading-screen-assets.mjs",
    "assets:loading-screen:verify": "node scripts/verify-loading-screen-assets.mjs"
  },
  "dependencies": {
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.181.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
